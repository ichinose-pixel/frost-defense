{
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "prettier": "3.9.6",
    "three": "0.160.0"
  },
  "name": "frost-defense",
  "version": "17.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests styles index.html README.md docs",
    "check": "npm run build && npm test",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1"
  },
  "engines": {
    "node": ">=22"
  }
}
